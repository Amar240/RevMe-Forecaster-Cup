{
  "info": {
    "_postman_id": "3c7d7f4a-9b9b-4ad4-9b2a-bd6a4af2f0aa",
    "name": "RevME Forecaster Cup API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "REPLACE_ADMIN_EMAIL" },
    { "key": "adminPassword", "value": "REPLACE_ADMIN_PASSWORD" },
    { "key": "studentEmail", "value": "student@example.edu" },
    { "key": "studentPassword", "value": "Student123!" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const csrf = pm.cookies.get('revme_csrf');",
          "if (csrf) {",
          "  pm.request.headers.upsert({ key: 'X-CSRF-Token', value: csrf });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF (auth/me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Teams (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/teams"
          }
        },
        {
          "name": "Users (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/users"
          }
        }
      ]
    },
    {
      "name": "Student",
      "item": [
        {
          "name": "Current Submission",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/submissions/current"
          }
        }
      ]
    }
  ]
}
