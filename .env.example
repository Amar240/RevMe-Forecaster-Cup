# Required application settings
DATABASE_URL="postgresql://revme:REPLACE_WITH_PASSWORD@localhost:5432/revme?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# Optional outbound email settings
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
SMTP_FROM="no-reply@example.com"

# Dev/testing: if set, admin-created accounts use this password instead of a random one
# and skip sending the password reset email. Never set this in production.
DEV_DEFAULT_PASSWORD="Amar@123"

# Optional archive storage settings
ARCHIVE_S3_BUCKET="revme-season-archives"
AWS_REGION="us-east-2"

# Local Docker only: set this in your shell when using docker-compose.aws.yml.
# Authenticate with `aws sso login --profile <profile>` before starting Docker.
# Never copy AWS access keys into this file.
AWS_PROFILE="default"

# Optional on-demand AI roster-import assistance. The deployment switch and
# the season-level ADMIN setting must both be enabled.
BEDROCK_IMPORT_ASSIST="false"
BEDROCK_IMPORT_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"

# Optional notification recipient for public demo requests
DEMO_REQUEST_NOTIFY_EMAIL="demo@example.com"

# Optional secret used to protect the Vercel cron endpoint for round processing
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Optional direct Google OAuth (both values are required to enable it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
